# ==============================================================================
# Coinbase Crypto Bot - Environment Configuration Template
# ==============================================================================

# Network & Host Binding
PORT=29600
HOST=0.0.0.0

# Fully Qualified Domain Name (FQDN) or localhost
# Example: bot.yourdomain.com (Leave blank or localhost for direct IP/local access)
FQDN=localhost

# Base URL Path
# Use "/" for root domain, or "/crypto" if reverse-proxied under a subpath
BASE_PATH=/

# Cryptographic Keys (Auto-generated by setup.sh)
# 64-character hex key used to encrypt API credentials at rest via AES-256-GCM
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Secret used to sign administrative session cookies
SESSION_SECRET=your_secure_session_secret_here

# Default Root Admin Username
ROOT_ADMIN_USER=admin

# Directory for SQLite storage and logs (defaults to ./data)
DATA_DIR=./data
